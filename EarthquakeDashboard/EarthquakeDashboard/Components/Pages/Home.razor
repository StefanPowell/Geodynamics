@page "/"
@rendermode InteractiveServer
@using MudBlazor
@inject EarthquakeDashboard.Services.SignalRService SignalRService

<PageTitle>Home</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudPaper Elevation="10" Class="pa-8 ma-8" Style="border: 2px solid #1976d2; border-radius: 4px;">
        <h3>Earthquake Counter</h3>
        <MudText Typo="Typo.h4">Current Count: @currentCount</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@IncrementNumber">
            Increment
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    private int currentCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await SignalRService.ConnectAsync("https://localhost:44395/EarthquakeHub");

        SignalRService.OnCounterUpdated -= UpdateCounter;
        SignalRService.OnCounterUpdated += UpdateCounter;
    }

    private void UpdateCounter(int count)
    {
        currentCount = count;
        InvokeAsync(StateHasChanged);
    }

    private async Task IncrementNumber()
    {
        await SignalRService.IncrementCounter();
    }
}
